<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <DefaultItemExcludes>$(DefaultItemExcludes);.work/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ElBruno.AI.Jev" Version="[$(JevPackageVersion)]" />
  </ItemGroup>
  <Target Name="RequirePackageVersion" BeforeTargets="CollectPackageReferences">
    <Error Condition="'$(JevPackageVersion)' == ''" Text="Run scripts/Test-Package.ps1, or supply an exact JevPackageVersion property and an isolated package feed." />
  </Target>
</Project>
